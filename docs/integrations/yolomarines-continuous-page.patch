   .veteran-resources-action img { width: 88px; height: 88px; }
 }
+
+/* A continuous NorCal page uses the parent viewport, not the growing frame. */
+html.norcal-embedded { overflow: hidden; scroll-behavior: auto; }
+.norcal-embedded .hero { min-height: max(660px, calc(var(--norcal-viewport-height) - 104px)); }
+@media (max-width: 850px) {
+ .norcal-embedded .hero { min-height: max(650px, calc(var(--norcal-viewport-height) - 64px)); }
+ .norcal-embedded .who-photo-wrap, .norcal-embedded .who-photo { max-height: calc(var(--norcal-viewport-height) * .6); }
+ .norcal-embedded .membership-photo-wrap, .norcal-embedded .membership-photo,
+ .norcal-embedded .service-photo-wrap, .norcal-embedded .service-photo { max-height: calc(var(--norcal-viewport-height) * .64); }
+}
+@media (max-width: 480px) { .norcal-embedded .hero { min-height: 680px; } }
diff --git a/tests/norcal-embed.test.mjs b/tests/norcal-embed.test.mjs
new file mode 100644
index 0000000..e930832
--- /dev/null
+++ b/tests/norcal-embed.test.mjs
@@ -0,0 +1,31 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {runInNewContext} from 'node:vm';
+const source=readFileSync(new URL('../public/norcal-embed.js',import.meta.url),'utf8');
+function setup(standalone=false){
+ const messages=[],listeners={},properties={},classes=new Set();let height=5000;
+ const parent={postMessage:(...args)=>messages.push(args)};
+ const window={parent,addEventListener:(name,fn)=>listeners[name]=fn};
+ if(standalone)window.parent=window;
+ const document={body:{getBoundingClientRect:()=>({height})},documentElement:{style:{setProperty:(key,value)=>properties[key]=value},classList:{add:name=>classes.add(name)}},addEventListener(){},fonts:{ready:{then(){}}}};
+ runInNewContext(source,{window,document,location:{hostname:'www.yolomarines.org'},ResizeObserver:class{observe(){}},requestAnimationFrame:fn=>fn()});
+ return {messages,listeners,properties,classes,parent,setHeight:value=>height=value};
+}
+test('only the approved parent can initialize continuous layout and receive height',()=>{
+ const f=setup(),data={type:'norcal:website:init',version:1,viewportHeight:900};
+ f.listeners.message({origin:'https://evil.test',source:f.parent,data});
+ f.listeners.message({origin:'https://www.norcalveterans.org',source:{},data});
+ f.listeners.message({origin:'https://www.norcalveterans.org',source:f.parent,data:{...data,viewportHeight:Infinity}});
+ assert.equal(f.messages.length,0);assert.equal(f.classes.size,0);
+ f.listeners.message({origin:'https://www.norcalveterans.org',source:f.parent,data});
+ assert.equal(f.properties['--norcal-viewport-height'],'900px');
+ assert.ok(f.classes.has('norcal-embedded'));
+ assert.equal(f.messages[0][0].height,5001);
+ assert.equal(f.messages[0][1],'https://www.norcalveterans.org');
+ f.setHeight(4000);f.listeners.message({origin:'https://www.norcalveterans.org',source:f.parent,data});
+ assert.equal(f.messages[1][0].height,4001);
+});
+test('standalone website visits retain their original layout',()=>{
+ const f=setup(true);assert.deepEqual(f.listeners,{});assert.equal(f.messages.length,0);assert.equal(f.classes.size,0);
+});
