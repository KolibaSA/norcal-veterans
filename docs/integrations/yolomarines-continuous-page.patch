diff --git a/public/norcal-embed.js b/public/norcal-embed.js
new file mode 100644
index 0000000..8480b31
--- /dev/null
+++ b/public/norcal-embed.js
@@ -0,0 +1,28 @@
+// Share only layout height with the approved NorCal parent. Standalone visits
+// keep the normal website layout and behavior.
+(() => {
+ if(window.parent===window)return;
+ const allowed=new Set(['https://www.norcalveterans.org','https://norcalveterans.org','https://norcal-veterans-staging.sterling-koliba.workers.dev']);
+ if(location.hostname==='127.0.0.1')allowed.add('http://127.0.0.1:8796');
+ let parentOrigin='',pending=false,lastHeight=0;
+ const report=()=>{
+  pending=false;
+  const height=Math.ceil(document.body.getBoundingClientRect().height)+1;
+  if(!parentOrigin||height<200||height>60000||height===lastHeight)return;
+  lastHeight=height;
+  window.parent.postMessage({type:'norcal:website:height',version:1,height},parentOrigin);
+ };
+ const schedule=()=>{if(!pending){pending=true;requestAnimationFrame(report);}};
+ window.addEventListener('message',event=>{
+  const data=event.data;
+  if(event.source!==window.parent||!allowed.has(event.origin)||data?.type!=='norcal:website:init'||data.version!==1||!Number.isFinite(data.viewportHeight)||data.viewportHeight<180||data.viewportHeight>3000)return;
+  parentOrigin=event.origin;
+  document.documentElement.style.setProperty('--norcal-viewport-height',Math.round(data.viewportHeight)+'px');
+  document.documentElement.classList.add('norcal-embedded');
+  lastHeight=0;
+  schedule();
+ });
+ new ResizeObserver(schedule).observe(document.body);
+ document.addEventListener('load',schedule,true);
+ document.fonts?.ready.then(schedule);
+})();
